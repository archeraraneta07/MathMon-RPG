# MathMon environment variables. Copy to .env (never commit real values).
# Azure Functions read these from app settings (Static Web App → Environment variables)
# or from api/local.settings.json when running `func start` locally.

# ---- Azure Cosmos DB (players, attempts, models) ------------------------------
# Either a connection string...
COSMOS_CONNECTION_STRING=
# ...or endpoint + key
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=mathmon

# ---- Azure Machine Learning ---------------------------------------------------
# Scoring URI + key of the classifier endpoint (python/deploy_azure_ml.py)
AZURE_ML_ENDPOINT=
AZURE_ML_KEY=
# Used by python/deploy_azure_ml.py and python/azure_ml_train_job.py
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=mathmon-rg
AZURE_ML_WORKSPACE=mathmon-ml
AZURE_ML_COMPUTE=cpu-cluster

# ---- Admin key for PUT /api/ml/model and GET /api/ml/training-data ------------
# Long random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`
ML_ADMIN_KEY=
