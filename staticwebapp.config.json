{
  "platform": {
    "apiRuntime": "node:20"
  },
  "routes": [
    { "route": "/python/*", "statusCode": 404 },
    { "route": "/database/*", "statusCode": 404 },
    { "route": "/tests/*", "statusCode": 404 },
    { "route": "/api/*", "allowedRoles": ["anonymous"] },
    { "route": "/js/*", "headers": { "Cache-Control": "public, max-age=3600" } },
    { "route": "/css/*", "headers": { "Cache-Control": "public, max-age=3600" } }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/js/*", "/css/*", "/audio/*", "/assets/*", "*.{js,css,json,png,jpg,svg,ico,glb,ogg,mp3,wav}"]
  },
  "mimeTypes": {
    ".glb": "model/gltf-binary",
    ".ogg": "audio/ogg"
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}
